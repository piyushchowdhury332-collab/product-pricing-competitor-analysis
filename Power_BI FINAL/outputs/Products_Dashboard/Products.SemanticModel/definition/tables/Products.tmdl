	/// Year-to-date revenue annualized by the number of elapsed months.
	measure 'Revenue Annualized Run Rate' = VAR _months = MONTH(MAX(Dim_Date[Date])) RETURN DIVIDE([Revenue YTD], _months) * 12
		formatString: #,0
		displayFolder: Time Intelligence\Analysis
		lineageTag: 5bdacdbe-da89-48d0-8346-6d0b05104443

	/// Year-to-date units annualized by the number of elapsed months.
	measure 'Units Annualized Run Rate' = VAR _months = MONTH(MAX(Dim_Date[Date])) RETURN DIVIDE([Units YTD], _months) * 12
		formatString: #,0
		displayFolder: Time Intelligence\Analysis
		lineageTag: 4359abcd-eed4-4e8f-ace7-ab13f7df3e6c

	measure 'Revenue Cumulative % of Year' = DIVIDE([Revenue YTD], CALCULATE([Total Revenue], ALLEXCEPT(Dim_Date, Dim_Date[Year])))
