table Products
	lineageTag: 057ac9dd-4093-4ba2-a8e9-19e268d5dc18

	measure 'Total Products' =
			
			DISTINCTCOUNT(Products[Product_ID])
		formatString: 0
		lineageTag: 29e5f406-f246-464c-8d46-671c1d8bebc8

	measure 'Total Observations' =
			
			COUNTROWS(Products)
		formatString: 0
		lineageTag: d31b9ab3-cf36-42b5-a9ce-f70217c63757

	measure 'Average Price' =
			
			AVERAGE(Products[Price])
		lineageTag: 6af79190-bb1a-44a1-aa72-57b5cfc9f418

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Rating' =
			
			AVERAGE(Products[Rating])
		formatString: 0.00
		lineageTag: 95f4e708-24ca-486e-ada2-f99cbb272f6a

	measure 'Average Discount %' =
			
			DIVIDE(
			    AVERAGE(Products[Discount_Percent]),
			    100
			)
		formatString: 0.0%
		lineageTag: 59254fbd-2783-4234-914c-71f5e9b238fc

	measure 'Total Revenue' =
			
			SUM(Products[Revenue])
		formatString: #,0
		lineageTag: 200dfeab-25ee-4be8-b2bd-de4beeb9b3e2

	measure 'Total Units Sold' =
			
			SUM(Products[Units_Sold])
		formatString: #,0
		lineageTag: eefdc9d5-41f1-4fe7-8d70-119723fde6f8

	measure 'Total Reviews' =
			
			SUM(Products[Review_Count])
		formatString: #,0
		lineageTag: 69b32de7-710d-48e0-9786-c4095682e334

	measure 'Median Price' =
			
			MEDIAN(Products[Price])
		lineageTag: 0b0e6881-462b-498c-9728-b377f7640941

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Price Index' =
			
			AVERAGE(Products[Price_Index])
		lineageTag: f30235cb-26af-4f9d-a7c9-441a4b345c04

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sum of discount amounts.
	measure 'Total Discount Amount' = SUM(Products[Discount_Amount])
		formatString: #,0
		displayFolder: Discounts
		lineageTag: cdcb4305-9a94-454e-881c-c8cea1841d10

	/// Average list price before discount.
	measure 'Average Original Price' = AVERAGE(Products[Original_Price])
		formatString: #,0.00
		displayFolder: Pricing
		lineageTag: 531dbc26-8e99-48c2-81d4-a04d3ce90f52

	/// Average discount amount per observation.
	measure 'Average Discount Amount' = AVERAGE(Products[Discount_Amount])
		formatString: #,0.00
		displayFolder: Discounts
		lineageTag: 8fa6c8a5-f875-44c6-8d42-d6011f257a35

	/// Highest price in the current filter context.
	measure 'Max Price' = MAX(Products[Price])
		formatString: #,0
		displayFolder: Pricing
		lineageTag: c345534b-d41a-4f2e-b66c-f5e2494a842b

	/// Lowest price in the current filter context.
	measure 'Min Price' = MIN(Products[Price])
		formatString: #,0
		displayFolder: Pricing
		lineageTag: 2b71d83c-cbf3-433c-9c7d-91dfc652118f

	/// Spread between highest and lowest price.
	measure 'Price Range' = [Max Price] - [Min Price]
		formatString: #,0
		displayFolder: Pricing
		lineageTag: 1ff9ae4f-1588-4267-aa48-32a8034e7d4d

	/// Total revenue divided by total units sold.
	measure 'Revenue per Unit' = DIVIDE([Total Revenue], [Total Units Sold])
		formatString: #,0.00
		displayFolder: Sales
		lineageTag: 6d428292-cd10-4391-9011-d25e601e4263

	/// Total revenue divided by number of observations.
	measure 'Average Revenue per Observation' = DIVIDE([Total Revenue], [Total Observations])
		formatString: #,0.00
		displayFolder: Sales
		lineageTag: 28157327-d112-4c05-95d2-9e5a1f6ebc35

	/// Average units sold per observation.
	measure 'Average Units Sold' = AVERAGE(Products[Units_Sold])
		formatString: #,0.00
		displayFolder: Sales
		lineageTag: 2c9eecf9-c7b3-44a9-a6ba-e3b4c756202c

	/// Revenue as a share of all revenue in the current selection.
	measure 'Revenue Share %' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALLSELECTED(Products)))
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 1027afe2-a182-426a-b041-590ea6e5195f

	/// Total reviews divided by number of observations.
	measure 'Average Reviews per Product' = DIVIDE([Total Reviews], [Total Observations])
		formatString: #,0.0
		displayFolder: Customer
		lineageTag: 2a9d9ded-57a5-49d6-9bfe-6d53ba390d64

	/// Average number of features per product.
	measure 'Average Features Count' = AVERAGE(Products[Features_Count])
		formatString: #,0.0
		displayFolder: Product
		lineageTag: 613022a6-6c3a-41a8-8b5c-1fcf32579b51

	/// Number of distinct brands.
	measure 'Distinct Brands' = DISTINCTCOUNT(Products[Brand])
		formatString: 0
		displayFolder: Product
		lineageTag: b6d40d58-9e37-479e-aae1-2a465efa6113

	/// Number of distinct categories.
	measure 'Distinct Categories' = DISTINCTCOUNT(Products[Category])
		formatString: 0
		displayFolder: Product
		lineageTag: 6465391a-61d7-4998-9e98-4a22fb2aa2a6

	measure 'Revenue YTD' = CALCULATE([Total Revenue], DATESYTD(Dim_Date[Date]))
		formatString: #,0
		displayFolder: Time Intelligence\Revenue
		lineageTag: 3934bccd-3452-4165-88f8-1b523d91de05

	measure 'Revenue QTD' = CALCULATE([Total Revenue], DATESQTD(Dim_Date[Date]))
		formatString: #,0
		displayFolder: Time Intelligence\Revenue
		lineageTag: dcfc868d-7bdd-43af-a693-45269bbd4ca4

	measure 'Revenue MTD' = CALCULATE([Total Revenue], DATESMTD(Dim_Date[Date]))
		formatString: #,0
		displayFolder: Time Intelligence\Revenue
		lineageTag: 993661e7-b6a8-41b6-bb5f-e49130ef2f7c

	/// Revenue for the same period last year.
	measure 'Revenue PY' = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(Dim_Date[Date]))
		formatString: #,0
		displayFolder: Time Intelligence\Revenue
		lineageTag: 21bcc100-1df6-48ed-b7db-f0cf81a43a6c

	/// Revenue for the previous quarter.
	measure 'Revenue PQ' = CALCULATE([Total Revenue], DATEADD(Dim_Date[Date], -1, QUARTER))
		formatString: #,0
		displayFolder: Time Intelligence\Revenue
		lineageTag: c6631089-90df-416a-9251-3d493ed2106e

	/// Revenue for the previous month.
	measure 'Revenue PM' = CALCULATE([Total Revenue], DATEADD(Dim_Date[Date], -1, MONTH))
		formatString: #,0
		displayFolder: Time Intelligence\Revenue
		lineageTag: 22aa8d88-74e2-422e-aa5a-c04c1c68f7fb

	/// Revenue for the previous day.
	measure 'Revenue PD' = CALCULATE([Total Revenue], DATEADD(Dim_Date[Date], -1, DAY))
		formatString: #,0
		displayFolder: Time Intelligence\Revenue
		lineageTag: 550d9102-233f-41c0-a74a-24a1ba272096

	/// Prior-year year-to-date revenue.
	measure 'Revenue PYTD' = CALCULATE([Revenue YTD], SAMEPERIODLASTYEAR(Dim_Date[Date]))
		formatString: #,0
		displayFolder: Time Intelligence\Revenue
		lineageTag: 15d46f9b-ac1c-4ed4-9ebe-12f4446cc8a8

	measure 'Revenue YoY Change' = [Total Revenue] - [Revenue PY]
		formatString: #,0;-#,0;0
		displayFolder: Time Intelligence\Revenue
		lineageTag: ca4d9212-0862-41b7-a7b7-cda418c0a808

	measure 'Revenue YoY %' = DIVIDE([Total Revenue] - [Revenue PY], [Revenue PY])
