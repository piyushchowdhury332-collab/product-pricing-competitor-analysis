	measure 'Units Last 90 Days' = CALCULATE([Total Units Sold], DATESINPERIOD(Dim_Date[Date], MAX(Dim_Date[Date]), -90, DAY))
		formatString: #,0
		displayFolder: Time Intelligence\Analysis
		lineageTag: e50197ef-565d-4f99-b5e2-3487b21b4350

	/// Compound annual growth rate of revenue between the first and last selected years.
	measure 'Revenue CAGR' = VAR _y0 = MIN(Dim_Date[Year]) VAR _y1 = MAX(Dim_Date[Year]) VAR _v0 = CALCULATE([Total Revenue], ALL(Dim_Date), Dim_Date[Year] = _y0) VAR _v1 = CALCULATE([Total Revenue], ALL(Dim_Date), Dim_Date[Year] = _y1) RETURN IF(_y1 > _y0 && _v0 > 0, DIVIDE(_v1, _v0) ^ (1 / (_y1 - _y0)) - 1)
		formatString: 0.0%
		displayFolder: Time Intelligence\Analysis
		lineageTag: 07cf61f9-791e-4175-bd6d-9ec654a26c9f

	measure 'Revenue YoY Trend' = IF(ISBLANK([Revenue YoY %]), "n/a", IF([Revenue YoY %] > 0, "Up", IF([Revenue YoY %] < 0, "Down", "Flat")))
