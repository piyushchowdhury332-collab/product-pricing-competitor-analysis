		lineageTag: 12e2a125-a77a-4fb6-b873-b78bc1ef9dce

	measure 'Units Last 7 Days' = CALCULATE([Total Units Sold], DATESINPERIOD(Dim_Date[Date], MAX(Dim_Date[Date]), -7, DAY))
		formatString: #,0
