		displayFolder: Time Intelligence\Analysis
		lineageTag: 2684ebfd-6d0a-4594-80b4-316b892dc15d

	measure 'Revenue Latest Month' = VAR _d = CALCULATE(MAX(Products[Date]), ALL(Products)) RETURN CALCULATE([Total Revenue], ALL(Dim_Date), Dim_Date[Year Month Number] = YEAR(_d) * 100 + MONTH(_d))
		formatString: #,0
		displayFolder: Time Intelligence\Analysis
		lineageTag: a811d6e8-34b5-4b7d-8d27-75fc8468312d

