		displayFolder: Time Intelligence\Revenue
		lineageTag: 391f4969-4fba-46e0-b4b3-64bee2db489f

	measure 'Revenue QoQ %' = DIVIDE([Total Revenue] - [Revenue PQ], [Revenue PQ])
